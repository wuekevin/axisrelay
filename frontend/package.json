{
  "name": "axisrelay-frontends",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config web/vite.config.js",
    "dev:admin": "vite --config admin/vite.config.js",
    "build": "node scripts/clean-dist.mjs && npm run build:web && npm run build:admin",
    "build:web": "node scripts/build-web-locales.mjs && vite build --config web/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "preview:web": "vite preview --config web/vite.config.js",
    "preview:admin": "vite preview --config admin/vite.config.js",
    "test": "node --experimental-strip-types --test admin/src/lib/*.test.mjs web/src/lib/*.test.mjs",
    "test:svg": "node --experimental-strip-types --test tests/qualityTestSVG.browser.test.mjs",
    "typecheck": "npm run typecheck:web && npm run typecheck:admin",
    "typecheck:web": "node scripts/build-web-locales.mjs && tsc -p web/tsconfig.json --noEmit",
    "typecheck:admin": "tsc -p admin/tsconfig.json --noEmit",
    "audit:ci": "node scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "i18next": "^25.10.9",
    "lucide-react": "^1.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.0",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.2"
  }
}
